<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.LoginController">

    <center>
        <VBox alignment="CENTER" spacing="20" styleClass="login-container">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>
            <Label text="%login.title" styleClass="title-label"/>

            <VBox spacing="10" maxWidth="300">
                <Label text="%login.username"/>
                <TextField fx:id="usernameField" promptText="s123456"/>

                <Label text="%login.password"/>
                <PasswordField fx:id="passwordField" promptText="********"/>

                <Label fx:id="errorLabel" styleClass="error-label" visible="false" wrapText="true"/>

                <Button text="%login.button" onAction="#handleLogin" styleClass="primary-button" maxWidth="Infinity"/>
            </VBox>

            <Separator/>

            <HBox alignment="CENTER" spacing="10">
                <Label text="Язык:"/>
                <ChoiceBox fx:id="languageChoice"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>